{
  "name": "@atoqueue/web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. exec vitest --run --workspace vitest.workspace.ts --project web",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build && node ../../deploy/scripts/write-pages-spa-fallback.mjs && node ../../deploy/scripts/verify-pages-spa-fallback.mjs"
  },
  "dependencies": {
    "@fontsource/kosugi": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
